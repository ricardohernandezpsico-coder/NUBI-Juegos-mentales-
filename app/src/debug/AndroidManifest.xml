<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- EXPERIMENTO (Tarea 190c, SOLO builds de depuración): la pantalla de Unity viene declarada SIN aceleración de dibujo (hardwareAccelerated="false" en el export) y la pantalla de carga de la app (Compose) se agrega a esa misma ventana,
             así que se dibuja con el procesador: la sonda midió un cuadro cada 150 ms (9 vueltas de la pantalla), igual en los 17 juegos y con Unity ocioso. Con la bandera en true la carga debería dibujarse con la tarjeta gráfica.
             Si la medición lo confirma, el arreglo real se decide aparte (esta bandera no va en release). -->
        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:hardwareAccelerated="true"
            tools:replace="android:hardwareAccelerated" />
    </application>

</manifest>
