<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".NeuroVidaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:replace="android:allowBackup">
        <!-- Toda la app es solo vertical (ver screenOrientation abajo). Desde targetSdk 36, Android 16 ignora la
             orientación fija en pantallas grandes (tablets, plegables abiertos); esta propiedad pide mantenerla
             mientras las pantallas y los juegos no tengan diseño horizontal. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- unityLibrary (Fase 1 del roadmap, ver NeuroVida/CLAUDE.md) declara esta
             Activity con su propio intent-filter LAUNCHER (arrancaría como un ícono
             aparte en el launcher del sistema): se pisa acá para que solo MainActivity
             sea la puerta de entrada de la app; se lanza explícitamente por Intent desde
             el código nativo cuando corresponda. allowBackup se pisa arriba porque
             unityLibrary declara "false" y el merger de manifests no resuelve solo un
             valor distinto al del host. screenOrientation se fija en vertical: los 9 juegos arman su interfaz para
             1080x1920 vertical y al girar se desarmaban (el export de Unity traía autorrotación). -->
        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:exported="false"
            android:process=":unity"
            android:screenOrientation="portrait"
            tools:node="merge"
            tools:replace="android:exported,android:screenOrientation">
            <intent-filter tools:node="removeAll" />
        </activity>
        <receiver
            android:name=".bridge.UnityResultReceiver"
            android:exported="false" />
        <!-- Tarjeta para compartir (ui/components/ShareCard): entrega la imagen a la app elegida sin permisos de almacenamiento. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
