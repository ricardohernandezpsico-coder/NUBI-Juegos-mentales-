<?xml version="1.0" encoding="utf-8"?>
<!--
  Qué se respalda (Android 11 e inferior; en Android 12+ ver data_extraction_rules.xml, que dice lo mismo).
  Solo el PROGRESO de la persona: la base de datos (partidas, avance por juego, perfil y ajustes) y las preferencias
  que forman parte de ese avance. Con esto un teléfono nuevo o restaurado recupera la liga, los logros, el avance de
  cada juego y la historia de la semana.
  NO se respalda el estado pasajero: la partida en pausa (paused_game), la sesión en curso (game_session), el inicio a medias (first_flight), la
  bandeja de resultados de Unity (unity_results), dónde quedó Juegos (library_focus) ni las preferencias de Unity.
  Restaurarlos en otro teléfono dejaría una partida "fantasma" a medias.
  Si se agrega un archivo de preferencias nuevo que sea progreso, hay que sumarlo aquí Y en data_extraction_rules.xml
  (hay una prueba, BackupRulesTest, que avisa si una preferencia no está en ninguna de las dos listas).
-->
<full-backup-content>
    <include domain="database" path="neurovida_database" />
    <include domain="database" path="neurovida_database-wal" />
    <include domain="sharedpref" path="skill.xml" />
    <include domain="sharedpref" path="star_measures.xml" />
    <include domain="sharedpref" path="word_collection.xml" />
    <include domain="sharedpref" path="atlas.xml" />
    <include domain="sharedpref" path="punta_words.xml" />
        <include domain="sharedpref" path="engranajes_rocket.xml" />
        <include domain="sharedpref" path="bodega_record.xml" />
        <include domain="sharedpref" path="constelaciones_record.xml" />
        <include domain="sharedpref" path="correo_record.xml" />
        <include domain="sharedpref" path="satelites_record.xml" />
    <include domain="sharedpref" path="unclear_sentences.xml" />
    <include domain="sharedpref" path="progress_log.xml" />
    <include domain="sharedpref" path="league_events.xml" />
    <include domain="sharedpref" path="achievements.xml" />
    <include domain="sharedpref" path="mission_log.xml" />
    <include domain="sharedpref" path="profile_extra.xml" />
</full-backup-content>
