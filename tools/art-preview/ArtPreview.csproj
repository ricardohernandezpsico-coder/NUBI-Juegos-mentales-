<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vista previa EXACTA del arte procedural de los juegos sin Unity: compila los generadores reales
    (ClayRaster, SymbolSprite, CardSprites, TreasureSprites, HeartSprite, TileGlyphSprite,
    CountStarSprite, MagnifierSprite, TileSprites, LunarSurfaceSprite) contra un UnityEngine mínimo
    (UnityStub.cs: Mathf, Color, Texture2D que guarda los píxeles...) y vuelca cada sprite a un .raw.
    Uso:  dotnet run (proyecto tools/art-preview), argumento: carpeta_raw
          luego: python3 tools/art-preview/compose.py carpeta_raw [opción antes]
    Si un generador nuevo usa otra API de Unity, agregarla al stub.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Src>$(MSBuildThisFileDirectory)../../unity/NeuroVidaCore/Assets/Scripts/Games</Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="UnityStub.cs" />
    <Compile Include="$(Src)/Shared/ClayRaster.cs" />
    <Compile Include="$(Src)/Parejas/SymbolSprite.cs" />
    <Compile Include="$(Src)/Parejas/CardSprites.cs" />
    <Compile Include="$(Src)/RutaTesoro/TreasureSprites.cs" />
    <Compile Include="$(Src)/Secuencia/HeartSprite.cs" />
    <Compile Include="$(Src)/Secuencia/TileGlyphSprite.cs" />
    <Compile Include="$(Src)/Secuencia/TileSprites.cs" />
    <Compile Include="$(Src)/Secuencia/TilePalette.cs" />
    <Compile Include="$(Src)/Shared/LunarSurfaceSprite.cs" />
    <Compile Include="$(Src)/Shared/RuleBadgeSprite.cs" />
    <Compile Include="$(Src)/Shared/ClayArrowSprite.cs" />
    <Compile Include="$(Src)/CambioChip/ChipShipSprite.cs" />
    <Compile Include="$(Src)/CambioChip/ChipContract.cs" />
    <Compile Include="$(Src)/Calculo/PondSprites.cs" />
    <Compile Include="$(Src)/Anagramas/AnagramSprites.cs" />
    <Compile Include="$(Src)/Stroop/NeonSignSprites.cs" />
    <Compile Include="$(Src)/Comparacion/CountStarSprite.cs" />
    <Compile Include="$(Src)/Series/MagnifierSprite.cs" />
    <Compile Include="$(Src)/Shared/AnswerMarkSprite.cs" />
    <Compile Include="$(Src)/Radar/RadarContract.cs" />
    <Compile Include="$(Src)/Radar/RadarSprites.cs" />
    <Compile Include="$(Src)/Freno/BrakeSprites.cs" />
    <Compile Include="$(Src)/Aterrizaje/LandingSprites.cs" />
    <Compile Include="$(Src)/Acoplamiento/DockingSprites.cs" />
    <Compile Include="$(Src)/Acoplamiento/DockingContract.cs" />
    <Compile Include="$(Src)/Trafico/TrafficSprites.cs" />
    <Compile Include="$(Src)/Trafico/TrafficContract.cs" />
    <Compile Include="$(Src)/Trafico/TrafficSounds.cs" />
  </ItemGroup>
</Project>
