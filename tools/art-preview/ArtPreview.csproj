<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vista previa EXACTA del arte procedural de los juegos sin Unity: compila los generadores reales
    (ClayRaster, SymbolSprite, ConstelacionSprites, BodegaSprites, RastroSprites, NubiTeacherSprite,
    MagnifierSprite, TileSprites, LunarSurfaceSprite) contra un UnityEngine mínimo
    (UnityStub.cs: Mathf, Color, Texture2D que guarda los píxeles...) y vuelca cada sprite a un .raw.
    Uso:  dotnet run (proyecto tools/art-preview), argumento: carpeta_raw
          luego: py -3 tools/art-preview/<juego>.py carpeta_raw (p. ej. constelaciones.py, bodega.py)
    Si un generador nuevo usa otra API de Unity, agregarla al stub.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Src>$(MSBuildThisFileDirectory)../../unity/NeuroVidaCore/Assets/Scripts/Games</Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="UnityStub.cs" />
    <Compile Include="$(Src)/Shared/ClayRaster.cs" />
    <Compile Include="$(Src)/Engranajes/EngranajesContract.cs" />
    <Compile Include="$(Src)/Engranajes/EngranajesSprites.cs" />
    <Compile Include="$(Src)/Bodega/BodegaContract.cs" />
    <Compile Include="$(Src)/Bodega/BodegaLayout.cs" />
    <Compile Include="$(Src)/Bodega/BodegaSprites.cs" />
    <Compile Include="$(Src)/Parejas/SymbolSprite.cs" />
    <Compile Include="$(Src)/Parejas/ConstelacionContract.cs" />
    <Compile Include="$(Src)/Parejas/ConstelacionLayout.cs" />
    <Compile Include="$(Src)/Parejas/ConstelacionSky.cs" />
    <Compile Include="$(Src)/Parejas/ConstelacionSprites.cs" />
    <Compile Include="$(Src)/../Contracts/CardsTelemetry.cs" />
    <Compile Include="$(Src)/Secuencia/TileSprites.cs" />
    <Compile Include="$(Src)/Secuencia/TilePalette.cs" />
    <Compile Include="$(Src)/Shared/LunarSurfaceSprite.cs" />
    <Compile Include="$(Src)/Piloto/PilotShipSprite.cs" />
    <Compile Include="$(Src)/Stroop/NeonSignSprites.cs" />
    <Compile Include="$(Src)/Shared/AnswerMarkSprite.cs" />
    <Compile Include="$(Src)/Radar/RadarContract.cs" />
    <Compile Include="$(Src)/Radar/RadarSprites.cs" />
    <Compile Include="$(Src)/Freno/BrakeSprites.cs" />
    <Compile Include="$(Src)/Aterrizaje/LandingSprites.cs" />
    <Compile Include="$(Src)/Acoplamiento/DockingSprites.cs" />
    <Compile Include="$(Src)/Acoplamiento/DockingContract.cs" />
    <Compile Include="$(Src)/Shared/PortSprites.cs" />
    <Compile Include="$(Src)/Shared/ShipSounds.cs" />
    <Compile Include="$(Src)/Bitacora/BitacoraSprites.cs" />
    <Compile Include="$(Src)/Bitacora/BitacoraContract.cs" />
    <Compile Include="$(Src)/Bitacora/BitacoraSounds.cs" />
    <Compile Include="$(Src)/Rumbo/HomingContract.cs" />
    <Compile Include="$(Src)/Rumbo/HomingSprites.cs" />
    <Compile Include="$(Src)/Rumbo/HomingSounds.cs" />
    <Compile Include="$(Src)/Correo/MailContract.cs" />
    <Compile Include="$(Src)/Correo/MailSprites.cs" />
    <Compile Include="$(Src)/Correo/MailSounds.cs" />
    <Compile Include="$(Src)/Meteoros/MeteorSprites.cs" />
    <Compile Include="$(Src)/Disparate/DisparateSprites.cs" />
    <Compile Include="$(Src)/Cosecha/CosechaSprites.cs" />
    <Compile Include="$(Src)/Cosecha/HuertoLayout.cs" />
    <!-- Rastro de luz (puro: el tablero, la escalera, la sesión y los sprites) y Nubi maestra del tutorial guiado -->
    <Compile Include="$(Src)/../Contracts/SequenceInitConfig.cs" />
    <Compile Include="$(Src)/../Contracts/SequenceTelemetry.cs" />
    <Compile Include="$(Src)/AdaptiveDifficulty.cs" />
    <Compile Include="$(Src)/DdaUserProfileConfig.cs" />
    <Compile Include="$(Src)/Secuencia/RastroContract.cs" />
    <Compile Include="$(Src)/Secuencia/RastroBoard.cs" />
    <Compile Include="$(Src)/Secuencia/RastroSession.cs" />
    <Compile Include="$(Src)/Secuencia/RastroSprites.cs" />
    <Compile Include="$(Src)/Shared/NubiTeacherSprite.cs" />
  </ItemGroup>
</Project>
